<Window x:Class="SeriTerm.App.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="230" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#202126" Foreground="#F2F3F6"
        FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True">
    <Border BorderBrush="#494B53" BorderThickness="1">
        <Grid Margin="32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/seriterm.ico" Width="32" Height="32" />
                    <TextBlock Text="SeriTerm" Margin="12,0,0,0" FontFamily="Segoe UI"
                               FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="串口工作台" Margin="44,7,0,0" FontSize="13" Foreground="#A8ABB4" />
            </StackPanel>
            <StackPanel Grid.Row="1">
                <TextBlock Text="正在准备工作区…" FontSize="12" Foreground="#A8ABB4" Margin="0,0,0,10" />
                <ProgressBar Height="3" IsIndeterminate="True" BorderThickness="0"
                             Background="#393B43" Foreground="#5B9FF0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
