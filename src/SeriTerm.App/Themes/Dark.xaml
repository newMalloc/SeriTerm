<?xml version="1.0" encoding="utf-8"?>
<!-- 黑灰表面、蓝色操作强调，状态与搜索使用少量语义色。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#181818" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#343434" />
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#161616" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#ECECEC" />
    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#A6A6A6" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#767676" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#292929" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#454545" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#353535" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#414141" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6FCC" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#86B7F5" />
    <SolidColorBrush x:Key="TxForegroundBrush" Color="#F2B76B" />
    <SolidColorBrush x:Key="RxForegroundBrush" Color="#ECECEC" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#202020" />

    <!-- 自绘标题栏（Windows 10 的系统标题栏不跟随主题，只能自己画）。
         标题栏不再是一条单独的色带：底色直接用 WindowBackgroundBrush，和窗口四周连成一片，
         所以这里没有 TitleBarBackgroundBrush 这个键了。 -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#343434" />
    <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#353535" />
    <SolidColorBrush x:Key="CaptionButtonPressedBrush" Color="#464646" />
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#E81123" />
    <SolidColorBrush x:Key="CaptionClosePressedBrush" Color="#F1707A" />

    <!-- 模糊背景（壁纸）之上的蒙版：决定壁纸透出多少、文字对比度是否够 -->
    <SolidColorBrush x:Key="BackdropTintBrush" Color="#AA1E1E1E" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#284A70" />
    <!-- 选区用低饱和蓝色，搜索命中用暖色，正文与面板仍保持中性灰。 -->
    <SolidColorBrush x:Key="MatchRowBrush" Color="#242424" />
    <SolidColorBrush x:Key="RowSelectionBrush" Color="#273D55" />
    <SolidColorBrush x:Key="CurrentMatchRowBrush" Color="#352F20" />
    <SolidColorBrush x:Key="MatchHighlightBrush" Color="#484026" />
    <SolidColorBrush x:Key="CurrentMatchHighlightBrush" Color="#695427" />
    <SolidColorBrush x:Key="OkBrush" Color="#5FCBA2" />
    <SolidColorBrush x:Key="WarnBrush" Color="#E0A030" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#E05A5A" />

    <!-- 让使用系统画刷的默认模板元素（弹层、滚动条底色、禁用文字）跟随主题 -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#161616" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#ECECEC" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#292929" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#ECECEC" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#284A70" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#A6A6A6" />

</ResourceDictionary>
