<?xml version="1.0" encoding="utf-8"?>
<!-- 深色主题配色（对齐参考工具的暗色观感） -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#252526" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#3C3C3C" />
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#9B9B9B" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#6A6A6A" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2D2D30" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#3A3A3D" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#454548" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0E7AD4" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TxForegroundBrush" Color="#FFA028" />
    <SolidColorBrush x:Key="RxForegroundBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#007ACC" />

    <!-- 自绘标题栏（Windows 10 的系统标题栏不跟随主题，只能自己画）。
         标题栏不再是一条单独的色带：底色直接用 WindowBackgroundBrush，和窗口四周连成一片，
         所以这里没有 TitleBarBackgroundBrush 这个键了。 -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#3C3C3C" />
    <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#3A3A3D" />
    <SolidColorBrush x:Key="CaptionButtonPressedBrush" Color="#464649" />
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#E81123" />
    <SolidColorBrush x:Key="CaptionClosePressedBrush" Color="#F1707A" />

    <!-- 模糊背景（壁纸）之上的蒙版：决定壁纸透出多少、文字对比度是否够 -->
    <SolidColorBrush x:Key="BackdropTintBrush" Color="#AA1E1E1E" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#264F78" />
    <!-- 日志区四种状态：普通命中行 = 极浅蓝底；选中行 = 更深蓝灰底 + 行首竖条；当前命中行 = 暗琥珀底；命中的字符 = 琥珀方块 -->
    <SolidColorBrush x:Key="MatchRowBrush" Color="#20303D" />
    <SolidColorBrush x:Key="RowSelectionBrush" Color="#39597A" />
    <SolidColorBrush x:Key="CurrentMatchRowBrush" Color="#4A3F1C" />
    <SolidColorBrush x:Key="MatchHighlightBrush" Color="#6E5A17" />
    <SolidColorBrush x:Key="CurrentMatchHighlightBrush" Color="#B07C10" />
    <SolidColorBrush x:Key="OkBrush" Color="#4EC94E" />
    <SolidColorBrush x:Key="WarnBrush" Color="#E0A030" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#E05A5A" />

    <!-- 让使用系统画刷的默认模板元素（弹层、滚动条底色、禁用文字）跟随主题 -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1B1B1B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8E8E8" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2D2D30" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E8E8E8" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#264F78" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#9B9B9B" />

</ResourceDictionary>
