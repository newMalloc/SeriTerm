<?xml version="1.0" encoding="utf-8"?>
<!-- 浅色主题配色：键名必须与 Dark.xaml 完全一致，否则切换会缺资源 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#EEF3F8" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SegmentTrackBrush" Color="#F2F4F6" />
    <SolidColorBrush x:Key="SegmentHoverBrush" Color="#E8EBEF" />
    <SolidColorBrush x:Key="SegmentSelectionBrush" Color="#DCE1E7" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#DCE5EF" />
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#203147" />
    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#5D7088" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#7C8DA2" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#EDF3FA" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#C7D4E2" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#E4EDF7" />
    <SolidColorBrush x:Key="ButtonHoverOverlayBrush" Color="#10004780" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#DCE7F3" />
    <Color x:Key="AccentColor">#176BA8</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="PrimaryActionBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ConnectedActionBrush" Color="#17674F" />
    <SolidColorBrush x:Key="PausedActionBrush" Color="#FEEDD2" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#176BA8" />
    <SolidColorBrush x:Key="TxForegroundBrush" Color="#C2610A" />
    <SolidColorBrush x:Key="RxForegroundBrush" Color="#203147" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#DCE6F0" />

    <!-- 自绘标题栏（Windows 10 的系统标题栏不跟随主题，只能自己画）。
         标题栏不再是一条单独的色带：底色直接用 WindowBackgroundBrush，和窗口四周连成一片，
         所以这里没有 TitleBarBackgroundBrush 这个键了。 -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#E1E1E1" />
    <SolidColorBrush x:Key="CaptionButtonPressedBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#E81123" />
    <SolidColorBrush x:Key="CaptionClosePressedBrush" Color="#F1707A" />

    <!-- 浅色玻璃用中性暖白透出背景色，正文保留深色。 -->
    <SolidColorBrush x:Key="BackdropTintBrush" Color="#99F4F4F4" />
    <SolidColorBrush x:Key="DesktopTintBrush" Color="#F7F6F5" />
    <SolidColorBrush x:Key="GlassPanelBrush" Color="#31FFFFFF" />
    <SolidColorBrush x:Key="GlassLogBrush" Color="#42FFFFFF" />
    <SolidColorBrush x:Key="GlassEdgeBrush" Color="#250F1116" />
    <SolidColorBrush x:Key="GlassControlBrush" Color="#16212A3D" />
    <SolidColorBrush x:Key="GlassHoverBrush" Color="#20212A3D" />
    <SolidColorBrush x:Key="GlassPressedBrush" Color="#23212A3D" />
    <SolidColorBrush x:Key="GlassTrackBrush" Color="#73FFFFFF" />
    <SolidColorBrush x:Key="GlassFlyoutBrush" Color="#F9F8F8" />
    <SolidColorBrush x:Key="GlassPopupBrush" Color="#B8F9F8F8" />
    <LinearGradientBrush x:Key="GlassAccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#ED196BA3" /><GradientStop Offset="1" Color="#DD155984" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassControlEdgeBrush" Color="#340F1116" />
    <SolidColorBrush x:Key="GlassTextBrush" Color="#25252A" />
    <SolidColorBrush x:Key="GlassSecondaryTextBrush" Color="#505058" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#CCE4F7" />
    <!--
        日志区四种状态各用一套颜色，深浅拉开档次，叠在同一行上也分得清：
        普通命中行 = 极浅蓝（MatchRowBrush，只是提示"这行里有命中"）；
        选中行     = 明显更深的蓝灰（RowSelectionBrush）+ 行首强调色竖条；
        当前命中行 = 淡琥珀底（CurrentMatchRowBrush）；
        命中的字符 = 淡琥珀方块，当前命中的那一段用强琥珀。
    -->
    <SolidColorBrush x:Key="MatchRowBrush" Color="#E9F2FA" />
    <SolidColorBrush x:Key="RowSelectionBrush" Color="#A9C4DD" />
    <SolidColorBrush x:Key="CurrentMatchRowBrush" Color="#FFEFC2" />
    <SolidColorBrush x:Key="MatchHighlightBrush" Color="#FFE49A" />
    <SolidColorBrush x:Key="CurrentMatchHighlightBrush" Color="#FFBE3D" />
    <SolidColorBrush x:Key="OkBrush" Color="#1E8E1E" />
    <SolidColorBrush x:Key="WarnBrush" Color="#B87300" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" />

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#203147" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#F0F0F0" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#203147" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#CCE4F7" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#203147" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#5D7088" />

</ResourceDictionary>
