<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SeriTerm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:SeriTerm.Core.Serial;assembly=SeriTerm.Core"
        xmlns:controls="clr-namespace:SeriTerm.App.Controls"
        Title="SeriTerm 串口调试助手"
        Icon="Assets/seriterm.ico"
        Height="800" Width="1280" MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
    <Grid>
        <Rectangle x:Name="DesktopTint" Visibility="Collapsed" IsHitTestVisible="False"
                   Fill="{DynamicResource DesktopTintBrush}" />
        <Grid x:Name="WorkspaceContent">
        <Rectangle x:Name="BackdropLayer" Visibility="Collapsed" IsHitTestVisible="False"
                   Opacity="{Binding BackgroundImageOpacity}"
                   RenderOptions.BitmapScalingMode="HighQuality">
            <Rectangle.Fill>
                <ImageBrush x:Name="BackdropBrush" Stretch="UniformToFill" />
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ImageTint" Visibility="Collapsed" Opacity="0.5" IsHitTestVisible="False"
                   Fill="{DynamicResource BackdropTintBrush}" />
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="40" Background="Transparent">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                            Margin="10,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/seriterm.ico" Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="SeriTerm" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="串口工作台" Margin="12,0,0,0" Foreground="{DynamicResource SubtleForegroundBrush}" FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <ToggleButton x:Name="SettingsButton" Style="{StaticResource TitleBarToggle}"
                                  Checked="OnSettingsToggled" Unchecked="OnSettingsToggled"
                                  AutomationProperties.Name="设置" ToolTip="设置（Ctrl+,）">
                        <Path Style="{StaticResource OutlineIcon}" Data="{StaticResource IconSettings}" Width="16" Height="16" StrokeThickness="1.25" />
                    </ToggleButton>
                    <Border Width="1" Height="16" Margin="6,0,8,0" VerticalAlignment="Center"
                            Background="{DynamicResource PanelBorderBrush}" />
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClick"
                            AutomationProperties.Name="最小化" ToolTip="最小化">
                        <Path Data="M 0,0 H 10" StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="OnMaximizeRestoreClick"
                            AutomationProperties.Name="最大化" ToolTip="最大化 / 还原">
                        <Path StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" />
                                    <Style.Triggers>
                                        <DataTrigger Value="Maximized"
                                                     Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Setter Property="Data"
                                                    Value="M 2.5,0.5 H 9.5 V 7.5 M 0.5,2.5 H 7.5 V 9.5 H 0.5 Z" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}" Click="OnCloseClick"
                            AutomationProperties.Name="关闭" ToolTip="关闭">
                        <Path Data="M 0.5,0.5 L 9.5,9.5 M 9.5,0.5 L 0.5,9.5" StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,7,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource SubtleForegroundBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:TransportState.Open}">
                                    <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:TransportState.Faulted}">
                                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:TransportState.Opening}">
                                    <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold"
                           Margin="0,0,10,0" />
                <TextBlock Grid.Column="2" Text="{Binding StatusDetail}"
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock x:Name="BufferStatus" Text="{Binding BufferStatusText}" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <TextBlock Text="Rx:" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding RxText}" Margin="0,0,8,0" ToolTip="{Binding RxRateText}" /><TextBlock Text="{Binding RxRateText}" Margin="0,0,16,0" Foreground="{DynamicResource SubtleForegroundBrush}" />
                    <TextBlock Text="Tx:" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding TxText}" Margin="0,0,8,0" ToolTip="{Binding TxRateText}" /><Button Content="复位" Command="{Binding ResetCountersCommand}" Style="{StaticResource SmallButton}" Margin="0,-3,12,-3" ToolTip="仅归零收发计数，不清空日志" />
                    <TextBlock Text="MCP:" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,0,5,0"
                               Visibility="{Binding McpEnabled, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding McpPermissionText}"
                               ToolTip="{Binding McpClientText}"
                               Visibility="{Binding McpEnabled, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding McpFullPermission}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="12,8,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="290" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="540" />
            </Grid.ColumnDefinitions>

            <!-- 固定列宽，不为滚动条预留空间；长设置页仍可用滚轮与键盘访问。 -->
            <ScrollViewer x:Name="SidebarScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource SectionPanel}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="设备连接" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="串口设备" Style="{StaticResource HintText}" Margin="0,0,0,6" />
                            <ComboBox x:Name="PortCombo" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"
                                      IsEnabled="{Binding CanSelectPort}" SelectionChanged="OnPortSelectionChanged"
                                      AutomationProperties.Name="串口设备" ToolTip="已连接时选择其他设备会切换连接" MinHeight="34" Margin="0,0,0,12">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Setter Property="ToolTip" Value="{Binding Display}" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Display}" />
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="64" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding PortName}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding DeviceName}" Foreground="{DynamicResource SubtleForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <TextBlock Text="波特率" Style="{StaticResource HintText}" Margin="0,0,0,6" />
                            <ComboBox x:Name="BaudRateCombo" IsEditable="True" Tag="NoFocusHighlight" ItemsSource="{Binding BaudRateOptions}"
                                      MaxDropDownHeight="Infinity" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      Text="{Binding BaudRateText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditBaudRate}"
                                      SelectionChanged="OnBaudRateSelectionChanged" DropDownOpened="OnBaudRateDropDownChanged" DropDownClosed="OnBaudRateDropDownChanged" AutomationProperties.Name="波特率"
                                      ToolTip="支持自定义波特率；已连接时修改会立即生效" MinHeight="34" />
                            <Grid Height="38" Margin="0,14,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ConnectionButton" Content="{Binding OpenButtonText}" Command="{Binding ToggleOpenCommand}"
                                        ToolTip="打开或关闭当前串口（F5）">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ConnectedActionBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button x:Name="LogPauseButton" Grid.Column="1" Width="40" Margin="8,0,0,0" Command="{Binding TogglePauseCommand}"
                                        AutomationProperties.Name="{Binding PauseButtonText}" AutomationProperties.AcceleratorKey="F6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="ToolTip" Value="暂停显示（F6）" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PausedActionBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                    <Setter Property="ToolTip" Value="继续显示（F6）" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Path Width="14" Height="14" Stretch="Uniform" IsHitTestVisible="False" Fill="{Binding Foreground, ElementName=LogPauseButton}">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="M 0,0 H 3 V 14 H 0 Z M 7,0 H 10 V 14 H 7 Z" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                        <Setter Property="Data" Value="M 0,0 L 11,7 L 0,14 Z" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>
                            </Grid>
                            <DockPanel Visibility="{Binding HasReconnectStatus, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="停止重连" Command="{Binding StopReconnectCommand}" Style="{StaticResource SmallButton}" />
                                <TextBlock Text="{Binding ReconnectStatusText}" Style="{StaticResource HintText}" />
                            </DockPanel>
                            <Expander x:Name="AdvancedConnectionExpander" Header="高级连接参数">
                                <StackPanel Margin="0,12,0,0">
                                    <CheckBox Content="断线自动重连" IsChecked="{Binding AutoReconnect}" Margin="0,0,0,12" />
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,6,10">
                                            <TextBlock Text="数据位" Style="{StaticResource HintText}" Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding DataBitOptions}" SelectedItem="{Binding DataBits}" IsEnabled="{Binding CanEditSettings}" AutomationProperties.Name="数据位" />
                                        </StackPanel>
                                        <StackPanel Margin="6,0,0,10">
                                            <TextBlock Text="停止位" Style="{StaticResource HintText}" Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding SelectedStopBits}" IsEnabled="{Binding CanEditSettings}" AutomationProperties.Name="停止位" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="校验 / 流控" Style="{StaticResource HintText}" Margin="0,0,0,5" />
                                    <ComboBox ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding SelectedParity}" IsEnabled="{Binding CanEditSettings}" Margin="0,0,0,8" AutomationProperties.Name="校验" />
                                    <ComboBox ItemsSource="{Binding HandshakeOptions}" SelectedItem="{Binding SelectedHandshake}" IsEnabled="{Binding CanEditSettings}" Margin="0,0,0,10" AutomationProperties.Name="流控" />
                                    <WrapPanel Margin="0,0,0,10">
                                        <CheckBox Content="DTR" IsChecked="{Binding DtrEnable}" IsEnabled="{Binding CanEditSettings}" Margin="0,0,20,0" />
                                        <CheckBox Content="RTS" IsChecked="{Binding RtsEnable}" IsEnabled="{Binding CanEditSettings}" />
                                    </WrapPanel>
                                    <CheckBox Content="启动时自动打开上次串口" IsChecked="{Binding AutoOpenOnStartup}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionPanel}" Padding="10,8">
                        <Grid x:Name="LogToolbar">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="LogSearchButton" Grid.Column="0" Content="查找" Command="{Binding OpenSearchCommand}" Style="{StaticResource ToolbarButton}" ToolTip="查找日志（Ctrl+F）" />
                            <Button x:Name="LogSaveButton" Grid.Column="1" Content="保存" Command="{Binding SaveLogCommand}" Style="{StaticResource ToolbarButton}" ToolTip="保存显示内容（Ctrl+S）" />
                            <Button x:Name="LogClearButton" Grid.Column="2" Content="清空" Command="{Binding ClearLogCommand}" Style="{StaticResource ToolbarButton}" Margin="0" ToolTip="清空显示内容（Ctrl+K）" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SectionPanel}" Padding="16,12">
                        <Expander Header="连接预设">
                            <StackPanel Margin="0,12,0,0">
                                <ComboBox x:Name="PresetCombo" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" IsEnabled="{Binding CanSelectPort}"
                                          AutomationProperties.Name="连接预设" ToolTip="选择后应用连接和显示参数；串口打开时自动切换">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <UniformGrid Columns="2" Margin="0,8,0,0">
                                    <Button Content="保存当前配置" Command="{Binding SavePresetCommand}" Margin="0,0,4,0" />
                                    <Button Content="删除预设" Command="{Binding DeletePresetCommand}" Margin="4,0,0,0" />
                                </UniformGrid>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <Border Style="{StaticResource SectionPanel}" Padding="16,12">
                        <Expander x:Name="ReceiveDisplayExpander" Header="接收与显示" IsExpanded="True">
                            <StackPanel Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <CheckBox x:Name="HexDisplayCheck" Content="HEX 显示" IsChecked="{Binding HexDisplay}" Margin="0,0,18,0" />
                                    <CheckBox x:Name="AutoScrollToggle" Content="跟随最新" IsChecked="{Binding AutoScroll}" ToolTip="上翻日志时自动停止跟随" />
                                </StackPanel>
                                <TextBlock Text="断帧方式" Style="{StaticResource HintText}" Margin="0,0,0,5" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="FramingCombo" ItemsSource="{Binding FramingOptions}" SelectedItem="{Binding SelectedFraming}"
                                              AutomationProperties.Name="断帧方式" />
                                    <DockPanel Grid.Column="1" Width="84" Margin="8,0,0,0" Visibility="{Binding IsGapFraming, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock DockPanel.Dock="Right" Text="ms" Margin="6,0,0,0" Style="{StaticResource HintText}" />
                                        <TextBox x:Name="FrameGapInput" Text="{Binding AutoFrameGapText, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="断帧间隔" ToolTip="空闲超过指定时间即结束当前帧（1～2000 ms）" />
                                    </DockPanel>
                                    <TextBox x:Name="FrameDelimiterInput" Grid.Column="1" Width="84" Margin="8,0,0,0"
                                             Text="{Binding DelimiterText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="分隔符"
                                             Visibility="{Binding IsDelimiterFraming, Converter={StaticResource BoolToVisibility}}" ToolTip="支持 \r \n \t \xNN 或 hex:0D 0A" />
                                </Grid>
                                <TextBlock Text="{Binding ReceiveValidationText}" Foreground="{DynamicResource ErrorBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers>
                                        <DataTrigger Binding="{Binding ReceiveValidationText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <Border Style="{StaticResource SectionPanel}" Padding="16,12">
                        <Expander Header="日志文件">
                            <StackPanel Margin="0,12,0,0">
                                <CheckBox x:Name="SaveLogCheck" Content="实时保存文本日志" IsChecked="{Binding SaveLogToFile}" Margin="0,0,0,10" />
                                <CheckBox Content="保存原始字节日志" IsChecked="{Binding SaveRawLog}" Margin="0,0,0,10" />
                                <TextBlock Text="{Binding LogDirectory}" Style="{StaticResource HintText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding LogDirectory}" />
                                <UniformGrid Columns="2" Margin="0,10,0,0">
                                    <Button Content="选择目录" Command="{Binding ChooseLogDirectoryCommand}" Margin="0,0,4,0" />
                                    <Button Content="打开目录" Command="{Binding OpenLogDirectoryCommand}" Margin="4,0,0,0" />
                                </UniformGrid>
                                <Button Content="打开原始日志…" Command="{Binding ImportRawLogCommand}" Margin="0,8,0,0" ToolTip="仅在界面查看历史记录，不向串口发送" />
                                <TextBlock Text="{Binding LogStatusText}" Style="{StaticResource HintText}" Margin="0,10,0,0"
                                           Visibility="{Binding IsLoggingEnabled, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Expander>
                    </Border>

                    <Border Style="{StaticResource SectionPanel}" Padding="16,12">
                        <Expander Header="AI 接入 · MCP">
                            <StackPanel Margin="0,12,0,0">
                                <CheckBox Content="启用 MCP 服务" IsChecked="{Binding McpEnabled}" Margin="0,0,0,10" />
                                <CheckBox Content="允许 AI 控制与发送" IsChecked="{Binding McpFullPermission}" Margin="0,0,0,10"
                                          ToolTip="开启后 AI 可开关串口、修改波特率和发送数据；默认只读" />
                                <TextBlock Text="{Binding McpServiceStateText}" Style="{StaticResource HintText}" />
                                <TextBlock Text="{Binding McpClientText}" Style="{StaticResource HintText}" Margin="0,4,0,10" />
                                <Button Content="复制客户端配置" Command="{Binding CopyMcpConfigCommand}" />
                            </StackPanel>
                        </Expander>
                    </Border>
                    <TextBlock Text="F5 连接 / 断开   ·   F6 暂停 / 继续&#10;Ctrl+F 查找   ·   Ctrl+S 保存日志   ·   F1 关于" Style="{StaticResource HintText}" Margin="10,6,0,6" LineHeight="22">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:5" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="120" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border x:Name="LogCard" CornerRadius="8" Background="{DynamicResource LogBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" SizeChanged="OnLogCardSizeChanged">
                    <Grid>
                        <controls:LogView x:Name="LogViewControl" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="20,8" IsHitTestVisible="False">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                                <DataTrigger Binding="{Binding Log.Lines.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers></Style></StackPanel.Style>
                            <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource ControlBackgroundBrush}" Margin="0,0,0,10">
                                <Path Width="26" Height="22" Stretch="Uniform" Data="M 2,4 L 10,11 L 2,18 M 13,18 L 24,18" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2" />
                            </Border>
                            <TextBlock Text="{Binding EmptyLogTitle}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="{Binding EmptyLogHint}" Foreground="{DynamicResource SubtleForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="23" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="SendCard" Grid.Row="1" Style="{StaticResource SectionPanel}" Margin="0,6,0,0" Padding="10,7">
                    <StackPanel>
                        <Grid x:Name="SendToolbar">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SendTextBox" Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" MinHeight="32" MaxHeight="96" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" FontFamily="Consolas, Microsoft YaHei UI" Padding="8,5"
                                     AutomationProperties.Name="发送内容">
                                <TextBox.ToolTip>
                                    <StackPanel MaxWidth="360">
                                        <TextBlock Text="{Binding SendValidationText}" />
                                        <TextBlock Text="{Binding SendPreviewText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="Ctrl+Enter 发送 · Enter 换行" Margin="0,6,0,0" />
                                    </StackPanel>
                                </TextBox.ToolTip>
                            </TextBox>
                            <TextBlock Text="输入内容 · Ctrl+Enter 发送" Foreground="{DynamicResource DisabledForegroundBrush}" Margin="10,0"
                                       TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                                    <DataTrigger Binding="{Binding SendText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <Grid Grid.Column="1" Width="92" Height="32" Margin="6,0,0,0" VerticalAlignment="Center">
                                <ComboBox x:Name="SendHistoryBox" ItemsSource="{Binding SendHistory}" SelectedItem="{Binding SelectedSendHistory}"
                                          AutomationProperties.Name="最近发送记录" ToolTip="最近 30 条成功发送记录；选择后仅回填">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" MinWidth="160" MaxWidth="320" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="最近发送" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="8,0,20,0" IsHitTestVisible="False">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSendHistory}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBox x:Name="TimedIntervalBox" Grid.Column="2" Text="{Binding TimedSendIntervalText, UpdateSourceTrigger=LostFocus}" Width="44" Height="32" Margin="6,0,0,0" VerticalAlignment="Center"
                                     AutomationProperties.Name="定时发送间隔" ToolTip="定时发送间隔（秒），范围 0.05～86400" />
                            <TextBlock Grid.Column="3" Text="秒" Style="{StaticResource HintText}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            <Button x:Name="TimedSendButton" Grid.Column="4" Content="{Binding TimedSendButtonText}" Command="{Binding ToggleTimedSendCommand}" Height="32" Margin="6,0,0,0" VerticalAlignment="Center" />
                            <Button x:Name="SendFileButton" Grid.Column="5" Content="发送文件…" Command="{Binding SendFileCommand}" Height="32" Margin="6,0,0,0" VerticalAlignment="Center" />
                            <CheckBox x:Name="TerminalModeCheck" Grid.Column="6" Content="终端" IsChecked="{Binding TerminalMode}" Margin="8,0,0,0" VerticalAlignment="Center"
                                      AutomationProperties.Name="终端模式" ToolTip="终端模式：焦点离开发送框后，键盘输入直接发往串口" />
                            <CheckBox x:Name="SendHexCheck" Grid.Column="7" Content="HEX" IsChecked="{Binding SendHex}" Margin="8,0,0,0"
                                      VerticalAlignment="Center" ToolTip="以十六进制字节发送" AutomationProperties.Name="HEX 发送" />
                            <Button x:Name="SendButton" Grid.Column="8" Content="发送" Width="60" Height="32" VerticalAlignment="Center"
                                    Command="{Binding SendCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" ToolTip="发送当前内容（Ctrl+Enter）；Enter 换行" />
                        </Grid>
                        <TextBlock Text="{Binding SendValidationText}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                                   Visibility="{Binding HasSendError, Converter={StaticResource BoolToVisibility}}" />
                        <DockPanel Margin="0,5,0,0" Visibility="{Binding TimedSendEnabled, Converter={StaticResource BoolToVisibility}}">
                            <Button x:Name="StopTimedSendButton" DockPanel.Dock="Right" Content="停止定时" Command="{Binding ToggleTimedSendCommand}" Margin="12,0,0,0" />
                            <TextBlock Text="{Binding TimedSendStatusText}" Style="{StaticResource HintText}" />
                        </DockPanel>
                        <DockPanel Margin="0,5,0,0" Visibility="{Binding HasSendFileStatus, Converter={StaticResource BoolToVisibility}}">
                            <Button x:Name="CancelFileSendButton" DockPanel.Dock="Right" Content="取消发送" Command="{Binding CancelFileSendCommand}" Margin="12,0,0,0"
                                    Visibility="{Binding IsSendingFile, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding SendFileStatusText}" Style="{StaticResource HintText}" />
                        </DockPanel>
                        <ProgressBar Height="3" Margin="0,5,0,0" Value="{Binding SendFileProgress}" Maximum="100" Visibility="{Binding IsSendingFile, Converter={StaticResource BoolToVisibility}}" />
                        <DockPanel Margin="0,5,0,0" Visibility="{Binding TerminalMode, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox DockPanel.Dock="Right" Content="退格 DEL" IsChecked="{Binding TerminalBackspaceSendsDel}" Margin="12,0,0,0" />
                            <CheckBox DockPanel.Dock="Right" Content="本地回显" IsChecked="{Binding TerminalLocalEcho}" Margin="12,0,0,0" />
                            <TextBlock Text="{Binding TerminalEchoText, StringFormat=终端当前输入：{0}}" Style="{StaticResource HintText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
        </Grid>
        <Grid x:Name="SettingsOverlay" Margin="0,40,0,0" Visibility="Collapsed" Panel.ZIndex="5">
            <Border Background="Transparent" PreviewMouseDown="OnSettingsOutsideClick" />
            <controls:GlassFlyout Width="364" Margin="12,4,12,17" HorizontalAlignment="Right" VerticalAlignment="Top"
                                  CornerRadius="10" Underlay="{Binding ElementName=WorkspaceContent}">
                <controls:SettingsFlyout x:Name="SettingsPanel"
                                     CloseRequested="OnSettingsCloseRequested" AboutRequested="OnAboutClick"
                                     ChooseImageRequested="OnChooseSettingsImage" />
            </controls:GlassFlyout>
        </Grid>
    </Grid>
    </Border>
</Window>
