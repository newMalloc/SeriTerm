<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SeriTerm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:SeriTerm.Core.Serial;assembly=SeriTerm.Core"
        Title="SeriTerm 串口调试助手"
        Height="800" Width="1280" MinHeight="520" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <DockPanel>

        <!-- ================= 顶部工具栏 ================= -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="SeriTerm" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Margin="4,0,16,0" />
                    <Button Style="{StaticResource ToolbarButton}" Content="A-" ToolTip="减小日志字号" />
                    <Button Style="{StaticResource ToolbarButton}" Content="A+" ToolTip="增大日志字号" />
                    <Button Style="{StaticResource ToolbarButton}" Content="自动换行" IsEnabled="False"
                            ToolTip="M2 实现" />
                    <Button Style="{StaticResource ToolbarButton}" Content="查找 Ctrl+F" IsEnabled="False"
                            ToolTip="M9 实现：实时搜索串口日志" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding ToggleThemeCommand}"
                            Content="{Binding ThemeButtonText}"
                            ToolTip="在深色 / 浅色主题之间切换" />
                    <Button Style="{StaticResource ToolbarButton}" Content="⚙" ToolTip="设置（M8）" />
                    <Button Style="{StaticResource ToolbarButton}" Content="?" ToolTip="帮助" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= 底部状态栏 ================= -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,5">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Ellipse Width="9" Height="9" Margin="0,0,7,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SubtleForegroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static core:TransportState.Open}">
                                        <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static core:TransportState.Faulted}">
                                        <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static core:TransportState.Opening}">
                                        <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding StatusDetail}"
                               Foreground="{DynamicResource SubtleForegroundBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="640" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Rx:" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding RxText}" Margin="0,0,16,0" />
                    <TextBlock Text="Tx:" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding TxText}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= 主体：左设置 / 右日志 ================= -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="306" MinWidth="248" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左：设置面板 ===== -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="10,10,8,10">
                <StackPanel>

                    <!-- 端口设置 -->
                    <Border Style="{StaticResource SectionPanel}">
                        <StackPanel>
                            <TextBlock Text="端口设置" Style="{StaticResource SectionHeader}" />

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="端口名:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Ports}"
                                          SelectedItem="{Binding SelectedPort}"
                                          IsEnabled="{Binding CanEditSettings}" />
                                <Button Grid.Column="2" Margin="4,0,0,0" Padding="0"
                                        Command="{Binding RefreshPortsCommand}"
                                        Content="⟳" FontSize="14"
                                        ToolTip="刷新串口列表（插拔 USB 转串口后点这里）" />
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="波特率:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1" IsEditable="True"
                                          ItemsSource="{Binding BaudRateOptions}"
                                          Text="{Binding BaudRateText, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanEditSettings}"
                                          ToolTip="可直接输入任意波特率，例如 1000000" />
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="数据位:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding DataBitOptions}"
                                          SelectedItem="{Binding DataBits}"
                                          IsEnabled="{Binding CanEditSettings}" />
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="校验位:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding ParityOptions}"
                                          SelectedItem="{Binding SelectedParity}"
                                          IsEnabled="{Binding CanEditSettings}" />
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="停止位:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding StopBitsOptions}"
                                          SelectedItem="{Binding SelectedStopBits}"
                                          IsEnabled="{Binding CanEditSettings}" />
                            </Grid>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="流控:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding HandshakeOptions}"
                                          SelectedItem="{Binding SelectedHandshake}"
                                          IsEnabled="{Binding CanEditSettings}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox Content="DTR" IsChecked="{Binding DtrEnable}"
                                          IsEnabled="{Binding CanEditSettings}" Margin="0,0,14,0"
                                          ToolTip="DTR 信号线状态（部分设备用它复位/进入下载模式）" />
                                <CheckBox Content="RTS" IsChecked="{Binding RtsEnable}"
                                          IsEnabled="{Binding CanEditSettings}"
                                          ToolTip="RTS 信号线状态；使用硬件流控时由驱动接管" />
                            </StackPanel>

                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ToggleOpenCommand}"
                                    Content="{Binding OpenButtonText}"
                                    Height="32" />
                        </StackPanel>
                    </Border>

                    <!-- 接收设置 -->
                    <Border Style="{StaticResource SectionPanel}">
                        <StackPanel>
                            <TextBlock Text="接收设置" Style="{StaticResource SectionHeader}" />
                            <TextBlock Style="{StaticResource HintText}">
                                十六进制显示、编码切换、自动断帧、保存到文件将在 M2 / M3 实现；<LineBreak />
                                Ctrl+F 实时搜索与自动滚动开关在 M9 实现。
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 发送设置 -->
                    <Border Style="{StaticResource SectionPanel}">
                        <StackPanel>
                            <TextBlock Text="发送设置" Style="{StaticResource SectionHeader}" />
                            <TextBox Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsOpen}" Margin="0,0,0,6" />
                            <Button Command="{Binding SendCommand}" Content="发送" Height="30"
                                    IsEnabled="{Binding IsOpen}" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,7,0,0">
                                M1 临时入口：固定 UTF-8 编码 + CRLF 行尾。<LineBreak />
                                HEX 发送、行尾可选、定时发送、文件发送在 M4 实现。
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" />

            <!-- ===== 右：日志区（M2 实现真正的日志控件） ===== -->
            <Border Grid.Column="2" Background="{DynamicResource LogBackgroundBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640" Margin="24">
                    <TextBlock Text="接收显示区"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource SubtleForegroundBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0" TextAlignment="Center"
                               HorizontalAlignment="Center">
                        日志视图（虚拟化列表、HEX/文本切换、自动断帧、Ctrl+F 搜索、自动滚动）在 M2 / M9 实现。
                    </TextBlock>

                    <Border Style="{StaticResource SectionPanel}" Margin="0,20,0,0" Padding="18,14" MinWidth="420">
                        <StackPanel>
                            <TextBlock Text="M1 已可用：收发字节计数" Style="{StaticResource SectionHeader}"
                                       HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <StackPanel Margin="0,0,34,0">
                                    <TextBlock Text="Rx 接收" Foreground="{DynamicResource SubtleForegroundBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding RxText}" FontSize="22" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Tx 发送" Foreground="{DynamicResource TxForegroundBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding TxText}" FontSize="22" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TxForegroundBrush}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,14,0,0" TextAlignment="Center">
                                你的 COM5 已把 TX 与 RX 短接，可直接自测：<LineBreak />
                                选 COM5 → 打开 → 点"发送"，Rx 计数应立刻随之增长。
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
