<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SeriTerm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:SeriTerm.Core.Serial;assembly=SeriTerm.Core"
        xmlns:controls="clr-namespace:SeriTerm.App.Controls"
        Title="SeriTerm 串口调试助手"
        Icon="Assets/seriterm.ico"
        Height="800" Width="1280" MinHeight="520" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!--
        自绘标题栏。Windows 10 上 DwmSetWindowAttribute(DWMWA_USE_IMMERSIVE_DARK_MODE)
        会被接受（返回 S_OK、读回也是 1）但对 Win32 窗口的标题栏毫无视觉效果，
        所以系统标题栏永远是一块白条，切主题时只有客户区变色。这里改用 WindowChrome
        自己画标题栏：颜色走 DynamicResource，切主题即时生效，也才能让标题栏参与背景模糊。
        CaptionHeight 必须与下面标题栏的高度一致，否则拖动/双击最大化会失灵。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
    <Grid>
        <!--
            背景模糊层：一块被大幅降采样+模糊过的桌面壁纸，按"屏幕坐标"对齐窗口，
            所以窗口移动时背景跟着桌面走，看起来像真的透出桌面（详见 DesktopBackdrop）。
            关掉"模糊背景"时这两层整体折叠，窗口回到不透明的纯色背景。
        -->
        <Rectangle x:Name="BackdropLayer" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality">
            <Rectangle.Fill>
                <ImageBrush x:Name="BackdropBrush" Stretch="Fill"
                            ViewboxUnits="RelativeToBoundingBox"
                            ViewportUnits="RelativeToBoundingBox"
                            Viewport="0,0,1,1" />
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="BackdropTint" Visibility="Collapsed"
                   Fill="{DynamicResource BackdropTintBrush}" />

    <DockPanel>

        <!-- ================= 自绘标题栏 ================= -->
        <Border DockPanel.Dock="Top" Height="34"
                Background="{DynamicResource TitleBarBackgroundBrush}">
            <!-- LastChildFill=False：否则最后那个"靠右"的按钮组会被当成填充元素，
                 结果三个窗口按钮跑到标题文字后面，而不是贴在右上角。 -->
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                            Margin="10,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/seriterm.ico" Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="SeriTerm 串口调试助手" Margin="8,0,0,0" FontSize="12.5" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClick"
                            AutomationProperties.Name="最小化" ToolTip="最小化">
                        <Path Data="M 0,0 H 10" StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="OnMaximizeRestoreClick"
                            AutomationProperties.Name="最大化" ToolTip="最大化 / 还原">
                        <Path StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" />
                                    <Style.Triggers>
                                        <DataTrigger Value="Maximized"
                                                     Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Setter Property="Data"
                                                    Value="M 2.5,0.5 H 9.5 V 7.5 M 0.5,2.5 H 7.5 V 9.5 H 0.5 Z" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}" Click="OnCloseClick"
                            AutomationProperties.Name="关闭" ToolTip="关闭">
                        <Path Data="M 0.5,0.5 L 9.5,9.5 M 9.5,0.5 L 0.5,9.5" StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= 顶部工具栏 ================= -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="SeriTerm" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Margin="4,0,16,0" />
                    <Button Style="{StaticResource ToolbarButton}" Content="A-" MinWidth="34"
                            Command="{Binding DecreaseFontSizeCommand}" ToolTip="减小日志字号" />
                    <Button Style="{StaticResource ToolbarButton}" Content="A+" MinWidth="34"
                            Command="{Binding IncreaseFontSizeCommand}" ToolTip="增大日志字号" />
                    <ToggleButton Style="{StaticResource ToolbarToggle}" Content="自动换行"
                                  IsChecked="{Binding LineWrap}" ToolTip="日志内容自动换行" />
                    <ToggleButton x:Name="AutoScrollToggle" Style="{StaticResource ToolbarToggle}" Content="自动滚动"
                                  IsChecked="{Binding AutoScroll}"
                                  ToolTip="跟随最新数据。滚离底部会自动停止，拉回底部会自动恢复" />
                    <Button Style="{StaticResource ToolbarButton}" Content="查找 Ctrl+F"
                            Command="{Binding OpenSearchCommand}" ToolTip="实时搜索日志（Ctrl+F）" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ToggleButton x:Name="BlurBackdropToggle" Style="{StaticResource ToolbarToggle}"
                                  Content="模糊背景"
                                  IsChecked="{Binding BlurBackground}"
                                  IsEnabled="{Binding BackdropAvailable}"
                                  ToolTip="窗口背景用亚克力模糊透出桌面壁纸（需要系统“透明效果”开启）；关闭后为纯色背景" />
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding ToggleThemeCommand}"
                            Content="{Binding ThemeButtonText}"
                            ToolTip="在深色 / 浅色主题之间切换" />
                    <Button Style="{StaticResource ToolbarButton}" Content="⚙" ToolTip="设置（M8）" />
                    <Button Style="{StaticResource ToolbarButton}" Content="?" ToolTip="帮助" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= 底部状态栏 ================= -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,5">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Ellipse Width="9" Height="9" Margin="0,0,7,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SubtleForegroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static core:TransportState.Open}">
                                        <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static core:TransportState.Faulted}">
                                        <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static core:TransportState.Opening}">
                                        <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding StatusDetail}"
                               Foreground="{DynamicResource SubtleForegroundBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="620" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SearchStatusText}"
                               Foreground="{DynamicResource SubtleForegroundBrush}"
                               Margin="0,0,16,0"
                               Visibility="{Binding SearchVisible, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="Rx:" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding RxText}" Margin="0,0,16,0" />
                    <TextBlock Text="Tx:" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding TxText}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= 主体：左设置 / 右日志 ================= -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="306" MinWidth="248" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左：设置面板 ===== -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="10,10,8,10">
                <StackPanel>

                    <!-- 端口设置 -->
                    <Border Style="{StaticResource SectionPanel}">
                        <StackPanel>
                            <TextBlock Text="端口设置" Style="{StaticResource SectionHeader}" />

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="预设:" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="PresetCombo" Grid.Column="1"
                                          ItemsSource="{Binding Presets}"
                                          SelectedItem="{Binding SelectedPreset}"
                                          ToolTip="选择即套用该预设的连接与显示配置" />
                                <Button Grid.Column="2" Margin="4,0,0,0" Padding="0" FontSize="13"
                                        Command="{Binding SavePresetCommand}" Content="★"
                                        ToolTip="把当前配置保存为预设（同名覆盖）" />
                                <Button Grid.Column="3" Margin="4,0,0,0" Padding="0" FontSize="12"
                                        Command="{Binding DeletePresetCommand}" Content="✕"
                                        ToolTip="删除选中的预设" />
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="端口名:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Ports}"
                                          SelectedItem="{Binding SelectedPort}"
                                          IsEnabled="{Binding CanEditSettings}" />
                                <Button Grid.Column="2" Margin="4,0,0,0" Padding="0"
                                        Command="{Binding RefreshPortsCommand}"
                                        Content="⟳" FontSize="14"
                                        ToolTip="刷新串口列表（插拔 USB 转串口后点这里）" />
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="波特率:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1" IsEditable="True"
                                          ItemsSource="{Binding BaudRateOptions}"
                                          Text="{Binding BaudRateText, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanEditSettings}"
                                          ToolTip="可直接输入任意波特率，例如 1000000" />
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="数据位:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding DataBitOptions}"
                                          SelectedItem="{Binding DataBits}"
                                          IsEnabled="{Binding CanEditSettings}" />
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="校验位:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding ParityOptions}"
                                          SelectedItem="{Binding SelectedParity}"
                                          IsEnabled="{Binding CanEditSettings}" />
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="停止位:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding StopBitsOptions}"
                                          SelectedItem="{Binding SelectedStopBits}"
                                          IsEnabled="{Binding CanEditSettings}" />
                            </Grid>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="流控:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding HandshakeOptions}"
                                          SelectedItem="{Binding SelectedHandshake}"
                                          IsEnabled="{Binding CanEditSettings}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox Content="DTR" IsChecked="{Binding DtrEnable}"
                                          IsEnabled="{Binding CanEditSettings}" Margin="0,0,14,0"
                                          ToolTip="DTR 信号线状态（部分设备用它复位/进入下载模式）" />
                                <CheckBox Content="RTS" IsChecked="{Binding RtsEnable}"
                                          IsEnabled="{Binding CanEditSettings}"
                                          ToolTip="RTS 信号线状态；使用硬件流控时由驱动接管" />
                            </StackPanel>

                            <CheckBox Content="自动重连" IsChecked="{Binding AutoReconnect}" Margin="0,0,0,4"
                                      ToolTip="链路中断后按 1/2/4/8/10 秒退避自动重连，设备插回来自动恢复" />
                            <CheckBox Content="启动时自动打开串口" IsChecked="{Binding AutoOpenOnStartup}"
                                      Margin="0,0,0,6"
                                      ToolTip="下次启动时自动打开上次使用的串口" />

                            <TextBlock Text="{Binding ReconnectStatusText}" Style="{StaticResource HintText}"
                                       Margin="0,0,0,6"
                                       Visibility="{Binding HasReconnectStatus, Converter={StaticResource BoolToVisibility}}" />

                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ToggleOpenCommand}"
                                    Content="{Binding OpenButtonText}"
                                    Height="32" />
                        </StackPanel>
                    </Border>

                    <!-- 接收设置 -->
                    <Border Style="{StaticResource SectionPanel}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="接收设置" Style="{StaticResource SectionHeader}"
                                           HorizontalAlignment="Left" Margin="0" />
                                <Button HorizontalAlignment="Right" Padding="8,1" MinHeight="22" FontSize="11.5"
                                        Command="{Binding TogglePauseCommand}"
                                        Content="{Binding PauseButtonText}"
                                        ToolTip="暂停只是停止刷新显示，串口数据仍在接收" />
                            </Grid>

                            <CheckBox x:Name="HexDisplayCheck" Content="十六进制显示"
                                      IsChecked="{Binding HexDisplay}" Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="编码:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding EncodingOptions}"
                                          SelectedItem="{Binding SelectedEncodingName}"
                                          ToolTip="文本显示使用的编码；中文设备常用 GB2312" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="断帧:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding FramingOptions}"
                                          SelectedItem="{Binding SelectedFraming}"
                                          ToolTip="空闲间隔断帧按时间切分；分隔符断帧按 CRLF 等字符切分，报文间隔再长也准确" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="间隔:" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding AutoFrameGapText}"
                                         IsEnabled="{Binding IsGapFraming}"
                                         ToolTip="空闲超过该毫秒数即认为一帧结束" />
                                <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource FieldLabel}"
                                           Margin="4,0,0,0" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="分隔符:" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding DelimiterText}"
                                         IsEnabled="{Binding IsDelimiterFraming}"
                                         ToolTip="支持 \r \n \t \xNN 转义，或 hex:0D 0A；也可直接写普通文本如 OK" />
                            </Grid>

                            <CheckBox Content="显示时间戳" IsChecked="{Binding ShowTimestamp}" Margin="0,0,0,6" />
                            <CheckBox Content="自动滚动" IsChecked="{Binding AutoScroll}" Margin="0,0,0,8"
                                      ToolTip="滚离底部自动停止，拉回底部自动恢复" />

                            <CheckBox x:Name="SaveLogCheck" Content="将接收保存到文件"
                                      IsChecked="{Binding SaveLogToFile}" Margin="0,0,0,4"
                                      ToolTip="实时写入文本日志；中文按当前编码解码" />
                            <CheckBox Content="同时保存原始字节（可重放）"
                                      IsChecked="{Binding SaveRawLog}" Margin="0,0,0,6"
                                      ToolTip="写入 .bin，含方向与时间戳，可用 RawLogReader 读回重放" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding LogDirectory}" Style="{StaticResource HintText}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip="{Binding LogDirectory}" />
                                <Button Grid.Column="1" Content="选择" Padding="8,1" MinHeight="22" FontSize="11.5"
                                        Margin="4,0,0,0" Command="{Binding ChooseLogDirectoryCommand}"
                                        ToolTip="更改日志保存目录" />
                                <Button Grid.Column="2" Content="打开" Padding="8,1" MinHeight="22" FontSize="11.5"
                                        Margin="4,0,0,0" Command="{Binding OpenLogDirectoryCommand}"
                                        ToolTip="在资源管理器中打开日志目录" />
                            </Grid>

                            <TextBlock Text="{Binding LogStatusText}" Style="{StaticResource HintText}"
                                       Margin="0,0,0,6"
                                       Visibility="{Binding IsLoggingEnabled, Converter={StaticResource BoolToVisibility}}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="保存数据" Command="{Binding SaveLogCommand}" Margin="0,0,4,0"
                                        ToolTip="把当前显示内容保存为文本日志（Ctrl+S）" />
                                <Button Grid.Column="1" Content="清空数据" Command="{Binding ClearLogCommand}"
                                        Margin="4,0,0,0" ToolTip="清空显示内容（Ctrl+K）" />
                            </Grid>

                            <TextBlock Style="{StaticResource HintText}" Margin="0,7,0,0"
                                       Text="文本模式下回车换行会显示为空格，避免一行被拆成多行；原始字节始终保留，切换十六进制即可查看。" />
                        </StackPanel>
                    </Border>

                    <!-- 发送设置 -->
                    <Border Style="{StaticResource SectionPanel}">
                        <StackPanel>
                            <TextBlock Text="发送设置" Style="{StaticResource SectionHeader}" />

                            <CheckBox x:Name="TerminalModeCheck" Content="终端模式" IsChecked="{Binding TerminalMode}"
                                      Margin="0,0,0,4"
                                      ToolTip="键盘输入直接进串口：可打印字符立即发送，回车按行尾设置发送，退格与 Ctrl+C 透传；焦点在输入框时不生效" />

                            <StackPanel Margin="18,0,0,6"
                                        Visibility="{Binding TerminalMode, Converter={StaticResource BoolToVisibility}}">
                                <CheckBox Content="本地回显（整行记一条 Tx）" IsChecked="{Binding TerminalLocalEcho}"
                                          Margin="0,0,0,4"
                                          ToolTip="终端模式下按行记录发送内容；设备本身会回显时可关掉以免重复" />
                                <CheckBox Content="退格发送 0x7F(DEL)" IsChecked="{Binding TerminalBackspaceSendsDel}"
                                          Margin="0,0,0,4"
                                          ToolTip="取消勾选则发送 0x08(BS)；有些 CLI 只认其中一种" />
                                <TextBlock Style="{StaticResource HintText}">
                                    <Run Text="当前输入：" /><Run Text="{Binding TerminalEchoText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <TextBox x:Name="SendTextBox"
                                     Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,6"
                                     MinHeight="46" MaxHeight="90" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="十六进制发送时填写 01 02 FF 这类内容；未打开串口时也可以先准备好内容" />

                            <CheckBox x:Name="SendHexCheck" Content="十六进制发送" IsChecked="{Binding SendHex}"
                                      Margin="0,0,0,6"
                                      ToolTip="勾选后按十六进制解析输入（宽容格式：空格、逗号、0x 前缀都可）" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="行尾:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding LineEndingOptions}"
                                          SelectedItem="{Binding SelectedLineEnding}"
                                          ToolTip="文本发送时自动附加的换行符；发二进制帧时选“无”" />
                            </Grid>

                            <Button Command="{Binding SendCommand}" Content="发送" Height="30"
                                    IsEnabled="{Binding IsOpen}" Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="定时:" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding TimedSendIntervalText}"
                                         ToolTip="定时发送间隔（秒），最小 0.05" />
                                <TextBlock Grid.Column="2" Text="秒" Style="{StaticResource FieldLabel}"
                                           Margin="4,0,0,0" />
                            </Grid>

                            <Button Command="{Binding ToggleTimedSendCommand}"
                                    Content="{Binding TimedSendButtonText}"
                                    Height="28" Margin="0,0,0,6"
                                    ToolTip="按设定间隔循环发送当前内容" />

                            <TextBlock Text="{Binding TimedSendStatusText}" Style="{StaticResource HintText}"
                                       Margin="0,0,0,6"
                                       Visibility="{Binding TimedSendEnabled, Converter={StaticResource BoolToVisibility}}" />

                            <Button Command="{Binding SendFileCommand}"
                                    Content="{Binding SendFileButtonText}"
                                    Height="28" Margin="0,0,0,6"
                                    ToolTip="把文件内容分块写入串口；发送中可点击取消" />

                            <ProgressBar Value="{Binding SendFileProgress}" Minimum="0" Maximum="100"
                                         Height="6" Margin="0,0,0,4"
                                         Visibility="{Binding IsSendingFile, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Text="{Binding SendFileStatusText}" Style="{StaticResource HintText}"
                                       Margin="0,0,0,6" />

                            <TextBlock Style="{StaticResource HintText}">
                                文本发送按当前编码转字节；HEX 发送解析 01 02 FF 这类内容。<LineBreak />
                                发送内容会以橙色 Tx 行记入日志（发送文件时只记开始与结束，避免刷屏）。
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" />

            <!-- ===== 右：日志视图 ===== -->
            <controls:LogView x:Name="LogViewControl" Grid.Column="2" />
        </Grid>
    </DockPanel>
    </Grid>
    </Border>
</Window>
