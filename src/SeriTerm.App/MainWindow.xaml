<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SeriTerm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:SeriTerm.Core.Serial;assembly=SeriTerm.Core"
        xmlns:controls="clr-namespace:SeriTerm.App.Controls"
        Title="SeriTerm 串口调试助手"
        Icon="Assets/seriterm.ico"
        Height="800" Width="1280" MinHeight="520" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!--
        自绘标题栏。Windows 10 上 DwmSetWindowAttribute(DWMWA_USE_IMMERSIVE_DARK_MODE)
        会被接受（返回 S_OK、读回也是 1）但对 Win32 窗口的标题栏毫无视觉效果，
        所以系统标题栏永远是一块白条，切主题时只有客户区变色。这里改用 WindowChrome
        自己画标题栏：颜色走 DynamicResource，切主题即时生效，也才能让标题栏参与背景模糊。
        CaptionHeight 必须与下面标题栏的高度一致，否则拖动/双击最大化会失灵。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
    <Grid>
        <!--
            背景模糊层：一块被大幅降采样+模糊过的桌面壁纸，按"屏幕坐标"对齐窗口，
            所以窗口移动时背景跟着桌面走，看起来像真的透出桌面（详见 DesktopBackdrop）。
            关掉"模糊背景"时这两层整体折叠，窗口回到不透明的纯色背景。
        -->
        <Rectangle x:Name="BackdropLayer" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality">
            <Rectangle.Fill>
                <ImageBrush x:Name="BackdropBrush" Stretch="Fill"
                            ViewboxUnits="RelativeToBoundingBox"
                            ViewportUnits="RelativeToBoundingBox"
                            Viewport="0,0,1,1" />
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="BackdropTint" Visibility="Collapsed"
                   Fill="{DynamicResource BackdropTintBrush}" />

    <DockPanel>

        <!-- ================= 标题栏 ================= -->
        <!--
            外观开关（模糊背景 / 深浅主题）放在标题栏，而不是单独占一行工具栏：
            原来的顶部工具栏里一半是重复项（自动滚动在侧栏还有一份）、
            两个死按钮（⚙/?)和一个与标题重复的 "SeriTerm" 字样，整行其实是多余的。
        -->
        <Border DockPanel.Dock="Top" Height="34"
                Background="{DynamicResource TitleBarBackgroundBrush}">
            <!-- LastChildFill=False：否则最后那个"靠右"的按钮组会被当成填充元素，
                 结果窗口按钮跑到标题文字后面，而不是贴在右上角。 -->
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                            Margin="10,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/seriterm.ico" Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="SeriTerm 串口调试助手" Margin="8,0,0,0" FontSize="12.5" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <ToggleButton x:Name="BlurBackdropToggle" Style="{StaticResource TitleBarToggle}"
                                  IsChecked="{Binding BlurBackground}"
                                  IsEnabled="{Binding BackdropAvailable}"
                                  AutomationProperties.Name="模糊背景"
                                  ToolTip="窗口背景用模糊过的桌面壁纸透出（需要系统“透明效果”开启）；关闭后为纯色背景">
                        <Grid Width="14" Height="14">
                            <Ellipse Width="11" Height="11" StrokeThickness="1.2" Fill="Transparent"
                                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
                            <Path Data="{StaticResource IconHalfDisc}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
                        </Grid>
                    </ToggleButton>

                    <Button Style="{StaticResource CaptionButton}"
                            Command="{Binding ToggleThemeCommand}"
                            AutomationProperties.Name="{Binding ThemeButtonText}"
                            ToolTip="{Binding ThemeButtonText}">
                        <Grid Width="14" Height="14">
                            <!-- 浅色主题下显示月亮（点一下切到深色） -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Path Data="{StaticResource IconMoon}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
                            </Grid>

                            <!-- 深色主题下显示太阳 -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Path Data="{StaticResource IconSunRays}" StrokeThickness="1.2"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
                                <Ellipse Width="5" Height="5"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
                            </Grid>
                        </Grid>
                    </Button>

                    <!-- 「关于」夹在主题按钮与分隔线之间：分隔线的作用是把右边三个窗口按钮
                         圈成一组，必须紧挨着它们；"这个程序自己是谁"的入口留在左边一组。 -->
                    <Button Style="{StaticResource CaptionButton}" Click="OnAboutClick"
                            FontSize="12.5" Content="关于"
                            AutomationProperties.Name="关于"
                            ToolTip="关于 SeriTerm：版本号、提交、运行时与 GitHub 仓库（F1）" />

                    <Border Width="1" Height="16" Margin="6,0,8,0" VerticalAlignment="Center"
                            Background="{DynamicResource PanelBorderBrush}" />

                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClick"
                            AutomationProperties.Name="最小化" ToolTip="最小化">
                        <Path Data="M 0,0 H 10" StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="OnMaximizeRestoreClick"
                            AutomationProperties.Name="最大化" ToolTip="最大化 / 还原">
                        <Path StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" />
                                    <Style.Triggers>
                                        <DataTrigger Value="Maximized"
                                                     Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Setter Property="Data"
                                                    Value="M 2.5,0.5 H 9.5 V 7.5 M 0.5,2.5 H 7.5 V 9.5 H 0.5 Z" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}" Click="OnCloseClick"
                            AutomationProperties.Name="关闭" ToolTip="关闭">
                        <Path Data="M 0.5,0.5 L 9.5,9.5 M 9.5,0.5 L 0.5,9.5" StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= 底部状态栏 ================= -->
        <!-- 用 Grid 而不是 DockPanel+StackPanel：详情文字放在星号列里，
             过长时按窗口宽度自动省略，不再需要写死 MaxWidth。
             搜索命中数只在搜索条里显示一次，这里不再重复。 -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,7,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource SubtleForegroundBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:TransportState.Open}">
                                    <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:TransportState.Faulted}">
                                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:TransportState.Opening}">
                                    <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold"
                           Margin="0,0,10,0" />
                <TextBlock Grid.Column="2" Text="{Binding StatusDetail}"
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Text="Rx:" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding RxText}" Margin="0,0,16,0" />
                    <TextBlock Text="Tx:" Foreground="{DynamicResource SubtleForegroundBrush}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding TxText}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 主体：左侧设置 / 右侧日志+发送 ================= -->
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- 360 而不是 306：左栏改成"一行两个"后要放得下"None（无校验）""软件（XOn/XOff）"
                     这类长值（实测 101.3 / 115.3 DIP，加内边距与箭头约 135 / 149）。
                     MinWidth 也从 248 提到 330：再窄下去一行两个根本放不下，
                     预设框会被压成 0 宽（实测过），不是"挤一点"而是坏了。
                     330 这一档长值会退化成省略号、三个复选框那行会折行，都还算能看。 -->
                <ColumnDefinition Width="360" MinWidth="330" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左：设置面板 ===== -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="10,10,8,10">
                <StackPanel>

                    <!-- 端口设置 -->
                    <Border Style="{StaticResource SectionPanel}">
                        <StackPanel>
                            <!-- 本段的"管理"动作用放在标题行右侧：挤在表单行里会把
                                 预设名/端口名压到只剩几十像素，只能显示成 "COM5 100…"。 -->
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="端口设置" Style="{StaticResource SectionHeader}" Margin="0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource SmallButton}" Content="刷新"
                                            Command="{Binding RefreshPortsCommand}"
                                            ToolTip="刷新串口列表（插拔 USB 转串口后点这里）" />
                                    <Button Style="{StaticResource SmallButton}" Margin="4,0,0,0" Content="保存预设"
                                            Command="{Binding SavePresetCommand}"
                                            ToolTip="把当前配置保存为预设（同名覆盖）" />
                                    <Button Style="{StaticResource SmallButton}" Margin="4,0,0,0" Content="删除预设"
                                            Command="{Binding DeletePresetCommand}"
                                            ToolTip="删除选中的预设" />
                                </StackPanel>
                            </Grid>

                            <!--
                                端口名单独占第一行（最上面）：先选口再谈参数。下面几行一律"一行两个"，
                                左半列是固定宽度（单值控件，够用就行），右半列吃剩余宽度（值长的那几个）。
                                这些宽度是拿真实字体量出来的，不是估的：13 号 Microsoft YaHei UI 下
                                "校验位:"=43.3、"流控:"=30.0、"None（无校验）"=101.3、"软件（XOn/XOff）"=115.3，
                                非可编辑下拉框的文字区约等于 宽度-26（7 左右内边距 + 右侧箭头 17）。
                                左侧列宽同步从 306 调到 360，否则右半列放不下这两个长值。
                            -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="端口名:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Ports}"
                                          SelectedItem="{Binding SelectedPort}"
                                          IsEnabled="{Binding CanEditSettings}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <!-- 波特率 | 预设 -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="98" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="波特率:" Style="{StaticResource FieldLabel}" />
                                <!-- 列表最后一项是"自定义输入…"：选中它由代码后置清空此框并把光标交给用户 -->
                                <ComboBox x:Name="BaudRateCombo" Grid.Column="1" IsEditable="True"
                                          ItemsSource="{Binding BaudRateOptions}"
                                          Text="{Binding BaudRateText, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanEditSettings}"
                                          SelectionChanged="OnBaudRateSelectionChanged"
                                          ToolTip="下拉选常用波特率；选「自定义输入…」后可填任意正整数，例如 1000000" />
                                <TextBlock Grid.Column="3" Text="预设:" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="PresetCombo" Grid.Column="4"
                                          ItemsSource="{Binding Presets}"
                                          SelectedItem="{Binding SelectedPreset}"
                                          ToolTip="选择即套用该预设的连接与显示配置">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <!-- 未选中时占位提示：不然下拉框是空白的，看着像坏了 -->
                                <TextBlock Grid.Column="4" Text="未选择预设" IsHitTestVisible="False"
                                           Foreground="{DynamicResource DisabledForegroundBrush}"
                                           Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPreset}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- 数据位 | 校验位 -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="数据位:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding DataBitOptions}"
                                          SelectedItem="{Binding DataBits}"
                                          IsEnabled="{Binding CanEditSettings}" />
                                <TextBlock Grid.Column="3" Text="校验位:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="4"
                                          ItemsSource="{Binding ParityOptions}"
                                          SelectedItem="{Binding SelectedParity}"
                                          IsEnabled="{Binding CanEditSettings}"
                                          ToolTip="None 无校验；Odd 奇校验；Even 偶校验；Mark 标记；Space 空格">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <!-- 停止位 | 流控 -->
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="停止位:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding StopBitsOptions}"
                                          SelectedItem="{Binding SelectedStopBits}"
                                          IsEnabled="{Binding CanEditSettings}" />
                                <TextBlock Grid.Column="3" Text="流控:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="4"
                                          ItemsSource="{Binding HandshakeOptions}"
                                          SelectedItem="{Binding SelectedHandshake}"
                                          IsEnabled="{Binding CanEditSettings}"
                                          ToolTip="软件（XOn/XOff）靠 XON/XOFF 字符控制；硬件（RTS/CTS）靠 RTS、CTS 信号线控制">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox Content="DTR" IsChecked="{Binding DtrEnable}"
                                          IsEnabled="{Binding CanEditSettings}" Margin="0,0,14,0"
                                          ToolTip="DTR 信号线状态（部分设备用它复位/进入下载模式）" />
                                <CheckBox Content="RTS" IsChecked="{Binding RtsEnable}"
                                          IsEnabled="{Binding CanEditSettings}"
                                          ToolTip="RTS 信号线状态；使用硬件流控时由驱动接管" />
                            </StackPanel>

                            <!-- 一行两个；面板被拖窄时 WrapPanel 自动折成两行，不会把文字挤出画面 -->
                            <WrapPanel Margin="0,0,0,6">
                                <CheckBox Content="自动重连" IsChecked="{Binding AutoReconnect}" Margin="0,0,14,4"
                                          ToolTip="链路中断后按 1/2/4/8/10 秒退避自动重连，设备插回来自动恢复" />
                                <CheckBox Content="启动时自动打开串口" IsChecked="{Binding AutoOpenOnStartup}"
                                          Margin="0,0,0,4"
                                          ToolTip="下次启动时自动打开上次使用的串口" />
                            </WrapPanel>

                            <TextBlock Text="{Binding ReconnectStatusText}" Style="{StaticResource HintText}"
                                       Margin="0,0,0,6"
                                       Visibility="{Binding HasReconnectStatus, Converter={StaticResource BoolToVisibility}}" />

                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ToggleOpenCommand}"
                                    Content="{Binding OpenButtonText}"
                                    Height="32" />
                        </StackPanel>
                    </Border>

                    <!-- 接收设置 -->
                    <Border Style="{StaticResource SectionPanel}">
                        <StackPanel>
                            <TextBlock Text="接收设置" Style="{StaticResource SectionHeader}" />

                            <!-- 显示时间戳 | 十六进制显示：一行两个 -->
                            <WrapPanel Margin="0,0,0,6">
                                <CheckBox Content="显示时间戳" IsChecked="{Binding ShowTimestamp}" Margin="0,0,14,4"
                                          ToolTip="每行前面显示接收时刻" />
                                <CheckBox x:Name="HexDisplayCheck" Content="十六进制显示"
                                          IsChecked="{Binding HexDisplay}" Margin="0,0,0,4"
                                          ToolTip="按字节显示接收内容。文本模式下回车换行会显示成空格，避免一行被拆成多行；原始字节始终保留，随时切回十六进制可查。" />
                            </WrapPanel>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="编码:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding EncodingOptions}"
                                          SelectedItem="{Binding SelectedEncodingName}"
                                          ToolTip="文本显示使用的编码；中文设备常用 GB2312" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="断帧:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding FramingOptions}"
                                          SelectedItem="{Binding SelectedFraming}"
                                          ToolTip="空闲间隔断帧按时间切分；分隔符断帧按 CRLF 等字符切分，报文间隔再长也准确" />
                            </Grid>

                            <!-- 间隔 | 分隔符：一行两个 -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="间隔:" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding AutoFrameGapText}"
                                         IsEnabled="{Binding IsGapFraming}"
                                         ToolTip="空闲超过该毫秒数即认为一帧结束" />
                                <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource FieldLabel}"
                                           Margin="4,0,0,0" />
                                <TextBlock Grid.Column="4" Text="分隔符:" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="5"
                                         Text="{Binding DelimiterText}"
                                         IsEnabled="{Binding IsDelimiterFraming}"
                                         ToolTip="支持 \r \n \t \xNN 转义，或 hex:0D 0A；也可直接写普通文本如 OK" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 日志显示 -->
                    <Border Style="{StaticResource SectionPanel}">
                        <StackPanel>
                            <!-- 「查找」只是打开搜索的入口，按钮留在这里（和"暂停显示"一起属于显示类动作）；
                                 查找框与收藏栏本身叠在日志右上角，见 LogView.xaml -->
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="日志显示" Style="{StaticResource SectionHeader}" Margin="0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource SmallButton}" Content="查找"
                                            Command="{Binding OpenSearchCommand}"
                                            ToolTip="实时搜索日志（Ctrl+F）；查找框与收藏栏会叠在日志右上角" />
                                    <Button Style="{StaticResource SmallButton}" Margin="4,0,0,0"
                                            Content="{Binding PauseButtonText}"
                                            Command="{Binding TogglePauseCommand}"
                                            ToolTip="暂停只是停止刷新显示，串口数据仍在接收" />
                                </StackPanel>
                            </Grid>

                            <!-- 自动滚动 | 自动换行 | 字号：一行三个。
                                 布尔选项一律用复选框（侧栏里样式统一），面板拖窄时整组折行。 -->
                            <WrapPanel Margin="0,0,0,6">
                                <CheckBox x:Name="AutoScrollToggle" Content="自动滚动"
                                          IsChecked="{Binding AutoScroll}" Margin="0,0,14,4"
                                          ToolTip="跟随最新数据。滚离底部会自动停止，拉回底部会自动恢复" />
                                <CheckBox Content="自动换行" IsChecked="{Binding LineWrap}" Margin="0,0,14,4"
                                          ToolTip="日志内容自动换行" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="字号:" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="FontSizeCombo" Width="60"
                                              ItemsSource="{Binding FontSizeOptions}"
                                              SelectedItem="{Binding LogFontSize}"
                                              ToolTip="日志区字号（只影响显示，不影响落盘内容）" />
                                </StackPanel>
                            </WrapPanel>

                            <!-- 保存 / 清空作用在"当前显示的内容"上，跟着日志设置一起留在左栏；
                                 右栏因此不再需要日志工具条那一行，日志区多回一行高度 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="保存" Margin="0,0,3,0"
                                        Command="{Binding SaveLogCommand}"
                                        ToolTip="把当前显示内容保存为文本日志（Ctrl+S）" />
                                <Button Grid.Column="1" Content="清空" Margin="3,0,0,0"
                                        Command="{Binding ClearLogCommand}"
                                        ToolTip="清空显示内容（Ctrl+K）" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 日志保存 -->
                    <Border Style="{StaticResource SectionPanel}">
                        <StackPanel>
                            <!-- 目录操作放标题行，路径就能占满整行完整显示，
                                 而不是被两个按钮挤成 "C:\Users\New\Documents\…" -->
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="日志保存" Style="{StaticResource SectionHeader}" Margin="0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource SmallButton}" Content="选择目录"
                                            Command="{Binding ChooseLogDirectoryCommand}"
                                            ToolTip="更改日志保存目录" />
                                    <Button Style="{StaticResource SmallButton}" Margin="4,0,0,0" Content="打开目录"
                                            Command="{Binding OpenLogDirectoryCommand}"
                                            ToolTip="在资源管理器中打开日志目录" />
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="SaveLogCheck" Content="将接收保存到文件"
                                      IsChecked="{Binding SaveLogToFile}" Margin="0,0,0,4"
                                      ToolTip="实时写入文本日志；中文按当前编码解码" />
                            <!-- 与上一个复选框是并列关系：只勾这一个也能单独存 .bin -->
                            <CheckBox Content="同时保存原始字节（可重放）"
                                      IsChecked="{Binding SaveRawLog}" Margin="0,0,0,6"
                                      ToolTip="写入 .bin，含方向与时间戳，可用 RawLogReader 读回重放" />

                            <TextBlock Text="{Binding LogDirectory}" Style="{StaticResource HintText}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding LogDirectory}" />

                            <TextBlock Text="{Binding LogStatusText}" Style="{StaticResource HintText}"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding IsLoggingEnabled, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" />

            <!-- ===== 右：日志 + 发送。发送区固定在日志下方，永远不用滚动去找"发送" ===== -->
            <!-- 日志上方不再有工具条那一行：显示设置、保存/清空、查找收藏都在左栏，
                 右键菜单与 Ctrl+C 负责复制选中的行 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:LogView x:Name="LogViewControl" Grid.Row="0" />

                <!-- ===== 发送区 ===== -->
                <Border Grid.Row="1"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="10,8">
                    <StackPanel>
                        <!-- 选项行用 WrapPanel：窗口窄的时候自动折行，不会把按钮挤出画面。
                             这里不要设 ItemHeight：它把每个子控件的排布高度锁成固定值。定时输入框
                             内部是 ScrollViewer，行高（微软雅黑 13 号 ≈ 16.5 + 内边距 6 + 边框 2 ≈ 24.7 DIP）
                             本来就比 26 大，被压到 26 后 ScrollViewer 的 Extent 18 > Viewport 11.33，
                             于是单行 TextBox 在内部悄悄竖向滚动（滚动条是隐藏的）——表现为数字被切掉
                             上半截、输入时上下滑动（实测 ScrollableHeight 6.67 DIP）。
                             不设就让行高跟着本行最高的子控件走，实测 ScrollableHeight 变 0。 -->
                        <WrapPanel Margin="0,0,0,6">
                            <CheckBox x:Name="TerminalModeCheck" Content="终端模式"
                                      IsChecked="{Binding TerminalMode}" Margin="0,0,14,0"
                                      ToolTip="键盘输入直接进串口：可打印字符立即发送，回车按行尾设置发送，退格与 Ctrl+C 透传；焦点在输入框时不生效" />
                            <CheckBox Content="本地回显" IsChecked="{Binding TerminalLocalEcho}"
                                      Margin="0,0,14,0"
                                      Visibility="{Binding TerminalMode, Converter={StaticResource BoolToVisibility}}"
                                      ToolTip="终端模式下按行记录发送内容；设备本身会回显时可关掉以免重复" />
                            <CheckBox Content="退格发 0x7F" IsChecked="{Binding TerminalBackspaceSendsDel}"
                                      Margin="0,0,14,0"
                                      Visibility="{Binding TerminalMode, Converter={StaticResource BoolToVisibility}}"
                                      ToolTip="取消勾选则发送 0x08(BS)；有些 CLI 只认其中一种" />

                            <CheckBox x:Name="SendHexCheck" Content="十六进制发送"
                                      IsChecked="{Binding SendHex}" Margin="0,0,14,0"
                                      ToolTip="勾选后按十六进制解析输入（宽容格式：空格、逗号、0x 前缀都可）" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <TextBlock Text="行尾:" Style="{StaticResource FieldLabel}" />
                                <ComboBox Width="126"
                                          ItemsSource="{Binding LineEndingOptions}"
                                          SelectedItem="{Binding SelectedLineEnding}"
                                          ToolTip="文本发送时自动附加的换行符；发二进制帧时选“无”" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <TextBlock Text="定时:" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="TimedIntervalBox" Width="54" Text="{Binding TimedSendIntervalText}"
                                         ToolTip="定时发送间隔（秒），最小 0.05" />
                                <TextBlock Text="秒" Style="{StaticResource FieldLabel}" Margin="4,0,0,0" />
                            </StackPanel>

                            <Button Content="{Binding TimedSendButtonText}" Margin="0,0,6,0"
                                    Command="{Binding ToggleTimedSendCommand}"
                                    ToolTip="按设定间隔循环发送当前内容" />
                            <Button Content="{Binding SendFileButtonText}"
                                    Command="{Binding SendFileCommand}"
                                    ToolTip="把文件内容分块写入串口；发送中可点击取消" />
                        </WrapPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SendTextBox"
                                     Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="54" MaxHeight="110"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     ToolTip="十六进制发送时填写 01 02 FF 这类内容；未打开串口时也可以先准备好内容" />
                            <Button Grid.Column="1" Width="90" Margin="8,0,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SendCommand}" Content="发送"
                                    IsEnabled="{Binding IsOpen}"
                                    VerticalAlignment="Stretch"
                                    ToolTip="把输入内容写入串口（文本按当前编码转字节，HEX 按十六进制解析）" />
                        </Grid>

                        <!-- 状态行：进度、文件发送、定时发送、终端当前输入，谁有内容谁占位置 -->
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar Width="160" Height="6" Margin="0,7,10,0" VerticalAlignment="Center"
                                         Value="{Binding SendFileProgress}" Minimum="0" Maximum="100"
                                         Visibility="{Binding IsSendingFile, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding SendFileStatusText}" Style="{StaticResource HintText}"
                                       Margin="0,7,14,0"
                                       Visibility="{Binding HasSendFileStatus, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding TimedSendStatusText}" Style="{StaticResource HintText}"
                                       Margin="0,7,14,0"
                                       Visibility="{Binding TimedSendEnabled, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                                        Visibility="{Binding TerminalMode, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="当前输入：" Style="{StaticResource HintText}" />
                                <TextBlock Text="{Binding TerminalEchoText, Mode=OneWay}" Style="{StaticResource HintText}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
    </Grid>
    </Border>
</Window>
