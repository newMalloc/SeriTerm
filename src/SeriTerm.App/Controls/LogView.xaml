<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SeriTerm.App.Controls.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:edit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:controls="clr-namespace:SeriTerm.App.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <edit:TextEditor x:Name="LogText" AutomationProperties.AutomationId="LogList"
                         AutomationProperties.Name="接收日志"
                         Background="Transparent" BorderThickness="0" Padding="10,7,0,3"
                         Foreground="{DynamicResource RxForegroundBrush}"
                         FontFamily="{Binding LogFontFamily}" FontSize="{Binding LogFontSize}"
                         ShowLineNumbers="{Binding ShowLogLineNumbers}" LineNumbersForeground="{DynamicResource SubtleForegroundBrush}"
                         IsReadOnly="True" WordWrap="{Binding LineWrap}"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <edit:TextEditor.Resources>
                <!-- WPF Track 以这个值的一半作为垂直滑块最小长度。 -->
                <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">64</sys:Double>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                    <Style.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="16" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </edit:TextEditor.Resources>
            <edit:TextEditor.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="复制" Command="Copy" InputGestureText="Ctrl+C"
                              CommandTarget="{Binding PlacementTarget.TextArea, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="全选" Command="SelectAll" InputGestureText="Ctrl+A"
                              CommandTarget="{Binding PlacementTarget.TextArea, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </edit:TextEditor.ContextMenu>
        </edit:TextEditor>

        <!-- ===== 暂停自动滚动时的"新数据"提示条 ===== -->
        <Button x:Name="NewDataBar"
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,14"
                Padding="14,6"
                Background="{DynamicResource AccentBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                Foreground="{DynamicResource AccentForegroundBrush}"
                Command="{Binding ScrollToLatestCommand}"
                Content="{Binding NewDataBarText}"
                ToolTip="点击回到最新位置并恢复自动滚动"
                Visibility="{Binding HasPendingNewLines, Converter={StaticResource BoolToVisibility}}" />

        <!-- ===== 暂停显示提示 ===== -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,10,0,0"
                Padding="12,5"
                CornerRadius="4"
                Background="{DynamicResource WarnBrush}"
                Grid.Row="1" Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding PausedHintText}" Foreground="#101010" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <!--
            ===== 右上角浮层：查找框 + 收藏栏 =====
            叠在日志上（不占行高），右边界留出滚动条的宽度，免得挡住拖动条。
            整块浮层的可见性只看查找开没开（ShowSearchOverlay == SearchVisible）：
            收藏栏是查找框下面的一段，按 Esc 关掉查找就得一起收起来，
            不能因为"还存着收藏"就继续浮在日志上挡字。
        -->
        <controls:GlassFlyout x:Name="SearchOverlay" Width="366" Underlay="{Binding ElementName=LogText}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="6,6,22,0"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Visibility="{Binding ShowSearchOverlay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <!-- 查找框。整块浮层已经在"查找开着"时才可见，这里不必再判一次 SearchVisible -->
                <Grid Margin="9,7,9,7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="查找:"
                               Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,7,0" />

                    <TextBox x:Name="SearchBox"
                             Grid.Row="0" Grid.Column="1"
                             MinWidth="100"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnSearchBoxKeyDown"
                             ToolTip="Ctrl+F 打开 / Esc 关闭，回车查找下一个，Shift+回车查找上一个" />

                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource ToolbarButton}"
                            Content="收藏" Width="50" Margin="6,0,4,0"
                            Command="{Binding AddSearchFavoriteCommand}"
                            IsEnabled="{Binding CanAddSearchFavorite}"
                            ToolTip="把当前关键字存进下面的「查找收藏」，以后点一下就能填回来" />

                    <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource ToolbarButton}"
                            MinWidth="0" Width="30" Margin="0" AutomationProperties.Name="关闭搜索"
                            Click="OnCloseSearchClick" ToolTip="关闭搜索（Esc）">
                        <Path Style="{StaticResource OutlineIcon}" Data="{StaticResource IconClose}" Width="10" Height="10" />
                    </Button>

                    <!-- 第二行：左边是命中数，右边是翻页与选项，窄窗口下命中数先被省略 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding SearchStatusText}"
                               Margin="0,6,8,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SubtleForegroundBrush}" />

                    <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <CheckBox Content="区分大小写" Margin="0,0,8,0"
                                  IsChecked="{Binding SearchCaseSensitive}" />
                        <Button Style="{StaticResource ToolbarButton}" Content="▲" MinWidth="28"
                                Command="{Binding SearchPreviousCommand}" ToolTip="上一个（Shift+Enter）" />
                        <Button Style="{StaticResource ToolbarButton}" Content="▼" MinWidth="28" Margin="0"
                                Command="{Binding SearchNextCommand}" ToolTip="下一个（Enter）" />
                    </StackPanel>
                </Grid>

                <!-- 收藏栏：有收藏时才出现，且只在查找开着时（浮层本身可见）才有意义。
                     上面永远有查找框，所以这条分隔线固定画出来。 -->
                <Expander Header="查找收藏" Margin="10,0,10,6" Visibility="{Binding HasSearchFavorites, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                    <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" />


                    <!-- 一屏放不下就自己滚：浮层高度不能被收藏数量拖着长 -->
                    <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
                        <ItemsControl ItemsSource="{Binding SearchFavorites}" Margin="6,0,6,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 每项独占一行：整行可点（套用该关键字），行尾 × 只删这一条。
                                         内层按钮用自己的 Command，点击不会连带触发外层
                                         （ButtonBase 会把鼠标事件标记为已处理）。
                                         AutomationProperties.Name 显式给出关键字：
                                         内容里套了 Grid，靠 WPF 自己推断名字会推断不出来，
                                         自动化脚本和读屏软件都会找不到这一行。 -->
                                    <Button Style="{StaticResource FavoriteRowButton}"
                                            ToolTip="{Binding}"
                                            AutomationProperties.Name="{Binding}"
                                            AutomationProperties.HelpText="点击把这条关键字填回查找框"
                                            Command="{Binding DataContext.ApplySearchFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Style="{StaticResource ChipCloseButton}" Content="✕"
                                                    ToolTip="从收藏里删除这一条"
                                                    AutomationProperties.Name="删除收藏"
                                                    Command="{Binding DataContext.RemoveSearchFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </controls:GlassFlyout>
    </Grid>
</UserControl>
