<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SeriTerm.App.Controls.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:SeriTerm.Core.Pipeline;assembly=SeriTerm.Core"
             x:Name="Root">

    <UserControl.Resources>
        <!--
            日志行内容的只读文本框。
            TextBlock 根本不支持选择，而"选中任意一段字符再复制"只有文本框能做；
            所以内容列改用只读 TextBox：把边框、底色、最小高度、焦点框、右键菜单全部去掉，
            外观和原来的 TextBlock 一致，多的只是能选字符。
            （每行一个 TextBox 只在可见行上存在——列表是虚拟化的，开销与行高同一量级。）
        -->
        <Style x:Key="LogLineText" TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ContextMenu" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="Foreground" Value="{DynamicResource RxForegroundBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Direction}" Value="{x:Static core:LineDirection.Tx}">
                    <Setter Property="Foreground" Value="{DynamicResource TxForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Direction}" Value="{x:Static core:LineDirection.System}">
                    <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.LineWrap, RelativeSource={RelativeSource AncestorType=ListBox}}"
                             Value="True">
                    <Setter Property="TextWrapping" Value="Wrap" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrentMatch}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource LogBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Ctrl+F 搜索条 ===== -->
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,5"
                Visibility="{Binding SearchVisible, Converter={StaticResource BoolToVisibility}}">
            <!-- 用 WrapPanel：窄窗口下按钮折行，而不是被裁掉 -->
            <WrapPanel>
                <TextBlock Text="查找:" Style="{StaticResource FieldLabel}" />

                <TextBox x:Name="SearchBox"
                         Width="240"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnSearchBoxKeyDown"
                         ToolTip="Ctrl+F 打开 / Esc 关闭，回车查找下一个，Shift+回车查找上一个" />

                <Button Style="{StaticResource ToolbarButton}" Content="收藏" Margin="6,0,4,0"
                        Command="{Binding AddSearchFavoriteCommand}"
                        IsEnabled="{Binding CanAddSearchFavorite}"
                        ToolTip="把当前关键字存进左栏「查找收藏」，以后点一下就能填回来" />

                <TextBlock Text="{Binding SearchStatusText}"
                           Margin="10,0,10,0"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />

                <Button Style="{StaticResource ToolbarButton}" Content="▲" MinWidth="28"
                        Command="{Binding SearchPreviousCommand}" ToolTip="上一个（Shift+Enter）" />
                <Button Style="{StaticResource ToolbarButton}" Content="▼" MinWidth="28"
                        Command="{Binding SearchNextCommand}" ToolTip="下一个（Enter）" />

                <CheckBox Content="区分大小写" Margin="8,0,10,0"
                          IsChecked="{Binding SearchCaseSensitive}" />

                <Button Style="{StaticResource ToolbarButton}" Content="✕"
                        Command="{Binding CloseSearchCommand}" ToolTip="关闭搜索（Esc）" />
            </WrapPanel>
        </Border>

        <!-- ===== 日志列表 ===== -->
        <Grid Grid.Row="1">
            <ListBox x:Name="LogList"
                     ItemsSource="{Binding Log.Lines}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,2,0,2"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     SelectionMode="Extended"
                     PreviewMouseLeftButtonDown="OnLogListPreviewMouseLeftButtonDown"
                     PreviewMouseLeftButtonUp="OnLogListPreviewMouseLeftButtonUp"
                     PreviewMouseRightButtonDown="OnLogListPreviewMouseRightButtonDown"
                     PreviewKeyDown="OnLogListPreviewKeyDown"
                     PreviewMouseMove="OnLogListPreviewMouseMove"
                     FontFamily="Consolas, Microsoft YaHei UI"
                     FontSize="{Binding LogFontSize}">

                <!-- 复制选中行：右键菜单与 Ctrl+C 走同一条命令（虚拟化列表不支持逐字选择，
                     选中粒度是"行"；复制出来的是屏幕上看到的那一行文本） -->
                <ListBox.CommandBindings>
                    <CommandBinding Command="Copy" CanExecute="OnCopyCanExecute" Executed="OnCopyExecuted" />
                </ListBox.CommandBindings>

                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="复制"
                                  Command="Copy"
                                  InputGestureText="Ctrl+C"
                                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </ListBox.ContextMenu>

                <!-- 选中反馈：整行底色 + 行首一道强调色竖条。
                     竖条宽度恒定，选中与否都不会让文字左右跳动；
                     命中行自带蓝底，所以选中态在命中行上只靠竖条体现，两者互不遮挡。 -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Selection" BorderThickness="2,0,0,0" BorderBrush="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Selection" Property="Background"
                                                    Value="{DynamicResource RowSelectionBrush}" />
                                            <Setter TargetName="Selection" Property="BorderBrush"
                                                    Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" Padding="6,1" Background="Transparent">
                            <!-- 用 Grid 而不是 StackPanel：内容列拿星号宽度，
                                 只读文本框才会在行宽内换行/裁剪，而不是把行撑宽 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 时间列 -->
                                <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                           Margin="0,0,6,0"
                                           Foreground="{DynamicResource SubtleForegroundBrush}"
                                           Visibility="{Binding DataContext.ShowTimestamp, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}" />

                                <!-- 方向列 -->
                                <TextBlock Grid.Column="1" Text="{Binding DirectionText}"
                                           Margin="0,0,4,0"
                                           Foreground="{DynamicResource SubtleForegroundBrush}" />

                                <!-- 内容列：只读文本框，鼠标可以选中任意一段字符再复制 -->
                                <TextBox x:Name="LineText" Grid.Column="2"
                                         Style="{StaticResource LogLineText}"
                                         Text="{Binding Text, Mode=OneWay}"
                                         SelectionChanged="OnLineTextSelectionChanged" />
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <!-- 命中：整行底色；顺序很重要，当前命中必须排在后面才能覆盖普通命中 -->
                            <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrentMatch}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ===== 暂停自动滚动时的"新数据"提示条 ===== -->
            <Button x:Name="NewDataBar"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,14"
                    Padding="14,6"
                    Background="{DynamicResource AccentBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource AccentForegroundBrush}"
                    Command="{Binding ScrollToLatestCommand}"
                    Content="{Binding NewDataBarText}"
                    ToolTip="点击回到最新位置并恢复自动滚动"
                    Visibility="{Binding HasPendingNewLines, Converter={StaticResource BoolToVisibility}}" />

            <!-- ===== 暂停显示提示 ===== -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,10,0,0"
                    Padding="12,5"
                    CornerRadius="4"
                    Background="{DynamicResource WarnBrush}"
                    Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding PausedHintText}" Foreground="#101010" FontWeight="SemiBold" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
