<UserControl x:Class="SeriTerm.App.Controls.SettingsFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:SeriTerm.App.Services"
             xmlns:send="clr-namespace:SeriTerm.Core.Send;assembly=SeriTerm.Core"
             KeyboardNavigation.TabNavigation="Cycle"
             AutomationProperties.Name="SeriTerm 设置">
    <UserControl.Resources>
        <Style x:Key="SettingsRow" TargetType="DockPanel">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="SettingsChoice" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="145" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SettingsDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="Margin" Value="0,9,0,12" />
        </Style>
        <Style x:Key="SettingsIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="29" />
            <Setter Property="Height" Value="29" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
        </Style>
        <Style x:Key="SettingsLink" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="35" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="Segments" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource SegmentTrackBrush}" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="3">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
                        <Setter Property="FocusVisualStyle">
                            <Setter.Value>
                                <Style TargetType="Control">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Control">
                                                <Border Width="12" Height="1" Margin="0,0,0,3"
                                                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                        Background="{DynamicResource SubtleForegroundBrush}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Segment" Background="Transparent" CornerRadius="5" Margin="1,0" Padding="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Segment" Property="Background" Value="{DynamicResource SegmentHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="Segment" Property="Background" Value="{DynamicResource SegmentSelectionBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="19" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Rail" CornerRadius="10" BorderThickness="1"
                                Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}">
                            <Ellipse x:Name="Knob" Width="11" Height="11" Margin="3,0" HorizontalAlignment="Left"
                                     Fill="{DynamicResource SubtleForegroundBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rail" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Rail" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Rail" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Rail" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OpacitySlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource ControlBorderBrush}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent">
                                                    <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="15" Height="15" VerticalAlignment="Center">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource AccentTextBrush}" CornerRadius="8"
                                                        BorderBrush="{DynamicResource FlyoutBackgroundBrush}" BorderThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,11,14,13">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,11">
                    <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource SettingsIconButton}" Visibility="Collapsed"
                            Click="OnBackClick" AutomationProperties.Name="返回设置" ToolTip="返回设置" Margin="-3,0,5,0">
                        <Path Style="{StaticResource OutlineIcon}" Data="{StaticResource IconBack}" Width="14" Height="14" />
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SettingsIconButton}" Click="OnCloseClick"
                            AutomationProperties.Name="关闭设置" ToolTip="关闭设置（Esc）" Margin="0,0,-4,0">
                        <Path Style="{StaticResource OutlineIcon}" Data="{StaticResource IconClose}" Width="11" Height="11" />
                    </Button>
                    <TextBlock x:Name="PageTitle" Text="设置" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <StackPanel x:Name="GeneralPage">
                            <TextBlock Text="串口与发送" Style="{StaticResource SettingsHeader}" />
                            <DockPanel Style="{StaticResource SettingsRow}">
                                <ComboBox x:Name="EncodingBox" DockPanel.Dock="Right" Style="{StaticResource SettingsChoice}"
                                          ItemsSource="{Binding EncodingOptions}" SelectedItem="{Binding SelectedEncodingName}"
                                          AutomationProperties.Name="字符编码" ToolTip="接收和发送共用字符编码" />
                                <TextBlock Text="字符编码" Style="{StaticResource SettingsLabel}" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource SettingsRow}">
                                <ListBox x:Name="EndingBox" DockPanel.Dock="Right" Style="{StaticResource Segments}" Width="183" VerticalAlignment="Center"
                                         ItemsSource="{Binding LineEndingOptions}" SelectedItem="{Binding SelectedLineEnding, Mode=TwoWay}"
                                         AutomationProperties.Name="发送行尾" ToolTip="附加在文本或 HEX 数据末尾；二进制协议通常选“无”">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="无" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Value}" Value="{x:Static send:LineEnding.CrLf}"><Setter Property="Text" Value="CRLF" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Value}" Value="{x:Static send:LineEnding.Cr}"><Setter Property="Text" Value="CR" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Value}" Value="{x:Static send:LineEnding.Lf}"><Setter Property="Text" Value="LF" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="LineEndingLabel" Text="发送行尾" Style="{StaticResource SettingsLabel}" />
                            </DockPanel>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <TextBlock Text="日志显示" Style="{StaticResource SettingsHeader}" />
                            <DockPanel Style="{StaticResource SettingsRow}">
                                <ComboBox x:Name="BufferBox" DockPanel.Dock="Right" Style="{StaticResource SettingsChoice}"
                                          ItemsSource="{Binding LogBufferOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding LogBufferMiB, Mode=TwoWay}" AutomationProperties.Name="日志缓冲上限"
                                          ToolTip="按原始字节计算，最多保留 20 万条记录；调低上限会淘汰最旧的显示记录" />
                                <TextBlock Text="日志缓冲上限" Style="{StaticResource SettingsLabel}" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource SettingsRow}">
                                <ComboBox x:Name="FontSizeBox" DockPanel.Dock="Right" Style="{StaticResource SettingsChoice}"
                                          ItemsSource="{Binding FontSizeOptions}" SelectedItem="{Binding LogFontSize}" AutomationProperties.Name="日志字号" />
                                <TextBlock x:Name="LogFontSizeLabel" Text="日志字号" Style="{StaticResource SettingsLabel}" />
                            </DockPanel>
                            <UniformGrid Columns="3" Margin="0,8,0,1">
                                <CheckBox Content="行号" IsChecked="{Binding ShowLogLineNumbers}" />
                                <CheckBox Content="时间戳" IsChecked="{Binding ShowTimestamp}" />
                                <CheckBox Content="自动换行" IsChecked="{Binding LineWrap}" />
                            </UniformGrid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <DockPanel Style="{StaticResource SettingsRow}" Margin="0,0,0,8">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}" IsChecked="{Binding KeepDisplayAwake}"
                                          AutomationProperties.Name="保持屏幕常亮" ToolTip="SeriTerm 运行时防止系统自动关闭显示器" />
                                <TextBlock Text="保持屏幕常亮" Style="{StaticResource SettingsLabel}" />
                            </DockPanel>
                            <Button x:Name="AppearanceButton" Style="{StaticResource SettingsLink}" Click="OnAppearanceClick">
                                <DockPanel>
                                    <Path DockPanel.Dock="Right" Style="{StaticResource OutlineIcon}" Data="{StaticResource IconChevronRight}" Width="8" Height="12" />
                                    <Path DockPanel.Dock="Left" Style="{StaticResource OutlineIcon}" Data="{StaticResource IconPalette}" Margin="0,0,8,0" />
                                    <TextBlock Text="个性化设置" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource SettingsLink}" Click="OnAboutClick" Margin="0,6,0,0" ToolTip="版本与仓库（F1）">
                                <DockPanel>
                                    <Path DockPanel.Dock="Right" Style="{StaticResource OutlineIcon}" Data="{StaticResource IconChevronRight}" Width="8" Height="12" />
                                    <Path DockPanel.Dock="Left" Style="{StaticResource OutlineIcon}" Data="{StaticResource IconInfo}" Width="15" Height="15" Margin="0,0,9,0" />
                                    <TextBlock Text="关于 SeriTerm" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
                            <TextBlock Text="主题" Style="{StaticResource SettingsHeader}" />
                            <ListBox x:Name="ThemeBox" Style="{StaticResource Segments}" ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Display"
                                     SelectedValuePath="Value" SelectedValue="{Binding SelectedTheme, Mode=TwoWay}" AutomationProperties.Name="主题" />
                            <Border Style="{StaticResource SettingsDivider}" />
                            <TextBlock Text="窗口背景" Style="{StaticResource SettingsHeader}" />
                            <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding BackgroundOptions}" DisplayMemberPath="Display"
                                     ToolTip="开启 Windows 的“透明效果”后，磨砂玻璃会柔和地透出窗口背后的颜色。"
                                     SelectedValuePath="Value" SelectedValue="{Binding BackgroundMode, Mode=TwoWay}" AutomationProperties.Name="窗口背景" />
                            <StackPanel x:Name="GlassSettingsRows" Margin="0,9,0,0"
                                       IsEnabled="{DynamicResource UseDesktopGlass}" ToolTipService.ShowOnDisabled="True">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BackgroundMode}" Value="{x:Static services:BackdropMode.Desktop}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.55" />
                                                <Setter Property="ToolTip" Value="系统当前未启用磨砂效果。请检查 Windows 的透明效果和高对比度设置。" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <DockPanel ToolTip="向右拖动，窗口背后的颜色会更明显。">
                                    <TextBlock DockPanel.Dock="Left" Width="65" Text="玻璃透明度" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock DockPanel.Dock="Right" Width="42" TextAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding GlassTransparency, StringFormat={}{0}%}" />
                                    <Slider x:Name="GlassTransparencySlider" Style="{StaticResource OpacitySlider}"
                                            Minimum="0" Maximum="100" TickFrequency="1" SmallChange="1" LargeChange="10"
                                            IsSnapToTickEnabled="True" Value="{Binding GlassTransparency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AutomationProperties.Name="玻璃透明度" />
                                </DockPanel>
                                <DockPanel Margin="0,5,0,0" ToolTip="向右拖动，窗口背后的文字和轮廓会更加模糊。">
                                    <TextBlock DockPanel.Dock="Left" Width="65" Text="模糊程度" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock DockPanel.Dock="Right" Width="42" TextAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding GlassBlurLabel}" />
                                    <Slider x:Name="GlassBlurSlider" Style="{StaticResource OpacitySlider}" Minimum="0" Maximum="2"
                                            TickFrequency="{Binding GlassBlurStep}" SmallChange="{Binding GlassBlurStep}" LargeChange="{Binding GlassBlurStep}"
                                            IsSnapToTickEnabled="True" Value="{Binding GlassBlurLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AutomationProperties.Name="模糊程度" AutomationProperties.ItemStatus="{Binding GlassBlurLabel}" />
                                </DockPanel>
                                <Button x:Name="ResetGlassButton" Content="恢复默认" Style="{StaticResource SmallButton}"
                                        HorizontalAlignment="Right" Margin="0,7,0,0" Command="{Binding ResetGlassSettingsCommand}"
                                        AutomationProperties.Name="恢复默认磨砂效果" ToolTip="将模糊程度恢复为强，玻璃透明度恢复为 45%" />
                            </StackPanel>
                            <Border Margin="0,8,0,0" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}" Padding="9,7">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BackgroundMode}" Value="{x:Static services:BackdropMode.Image}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="选择图片…" Style="{StaticResource SmallButton}" Click="OnChooseImageClick" />
                                        <TextBlock Text="{Binding BackgroundImageLabel}" Style="{StaticResource HintText}" VerticalAlignment="Center"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" ToolTip="{Binding BackgroundImagePath}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock DockPanel.Dock="Left" Text="图片不透明度" Style="{StaticResource SettingsLabel}" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding BackgroundImageOpacity, StringFormat={}{0:P0}}" Width="37"
                                                   TextAlignment="Right" VerticalAlignment="Center" />
                                        <Slider Style="{StaticResource OpacitySlider}" Minimum="0.1" Maximum="1" TickFrequency="0.05"
                                                IsSnapToTickEnabled="True" Value="{Binding BackgroundImageOpacity}" AutomationProperties.Name="图片不透明度" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <DockPanel Style="{StaticResource SettingsRow}">
                                <ComboBox x:Name="FontFamilyBox" DockPanel.Dock="Right" Style="{StaticResource SettingsChoice}"
                                          ItemsSource="{Binding LogFontOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding LogFontFamily, Mode=TwoWay}" AutomationProperties.Name="日志字体" />
                                <TextBlock Text="日志字体" Style="{StaticResource SettingsLabel}" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource SettingsRow}">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="窗口置顶"
                                          IsChecked="{Binding Topmost, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="窗口置顶（Ctrl+Shift+T）" />
                                <TextBlock Text="窗口置顶" Style="{StaticResource SettingsLabel}" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
