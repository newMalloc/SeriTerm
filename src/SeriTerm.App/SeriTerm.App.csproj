<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 有 8.x 就用 8.x（Main 的语义是"找不到 8.x 才往上跨大版本"）。
         这样只装了 .NET 9/10 桌面运行时的机器不必再下载 8.x 安装包，
         与启动器 RuntimeProbe 的判定保持一致。 -->
    <RollForward>Major</RollForward>
    <RootNamespace>SeriTerm.App</RootNamespace>
    <AssemblyName>SeriTerm</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\seriterm.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 同时作为资源，供窗口标题栏使用 -->
    <Resource Include="Assets\seriterm.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SeriTerm.Core\SeriTerm.Core.csproj" />
  </ItemGroup>

</Project>
